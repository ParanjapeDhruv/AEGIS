# Application
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000

# MySQL
DATABASE_URL=mysql+pymysql://username:password@localhost:3306/aegis

# Authentication
JWT_SECRET_KEY=replace-with-a-long-random-value
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480

# Gemini
GEMINI_API_KEY=replace-with-your-gemini-api-key

# Frontend
VITE_API_BASE_URL=http://127.0.0.1:8000

# Microservice ports (for Docker)
AUTH_SERVICE_PORT=8001
ANALYSIS_SERVICE_PORT=8002
AI_SERVICE_PORT=8003
REPORT_SERVICE_PORT=8004
